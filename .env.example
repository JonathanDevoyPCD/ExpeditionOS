OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional future provider
GEOAPIFY_API_KEY=

# Configured later for authenticated persistence. Never expose the secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Enable only after configuring an SMS provider in Supabase Auth.
SUPABASE_PHONE_OTP_ENABLED=false

# Canonical hosted URL, for example https://expeditionos.example.com
SITE_URL=http://localhost:3010

# Strava OAuth. Keep all values server-only and configure the callback domain in Strava.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STRAVA_TOKEN_ENCRYPTION_KEY=
